NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Sign-In: copy file này sang apps/frontend/.env.local rồi điền Client ID.
# Google Cloud Console > Google Auth Platform > Clients > OAuth client ID (Web application).
# Authorized JavaScript origins: http://localhost:3000 và origin frontend thực tế khi deploy.
# Client ID có dạng <PROJECT_NUMBER>-<CLIENT_ID>.apps.googleusercontent.com.
# Đây là ID công khai, KHÔNG điền Client Secret, access token hoặc ID token vào đây.
# Luồng Google Identity Services hiện tại không dùng redirect URI hay Client Secret.
# Khởi động lại Next.js sau khi đổi; khi deploy cần build lại để cập nhật NEXT_PUBLIC_*.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
