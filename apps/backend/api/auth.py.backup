"""Authentication API endpoints for user registration and login."""

from __future__ import annotations

import logging
import secrets
from typing import AsyncGenerator

import httpx
from fastapi import APIRouter, Depends, HTTPException, status
from fastapi.security import HTTPBearer
from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

from apps.backend.core.security import (
    create_access_token,
    create_password_reset_token,
    get_current_user,
    hash_password,
    verify_password,
    verify_password_reset_token,
)
from apps.backend.core.email import get_email_service
from apps.backend.db.base import AsyncSessionLocal
from apps.backend.models.admin import AdminAccount
from apps.backend.schemas.auth import (
    ErrorResponse,
    ForgotPasswordRequest,
    GoogleAuthRequest,
    LoginRequest,
    LoginResponse,
    RegisterRequest,
    RegisterResponse,
    ResetPasswordRequest,
    UserResponse,
)

log = logging.getLogger(__name__)

router = APIRouter(prefix="/api/auth", tags=["Authentication"])
security = HTTPBearer()


async def get_db() -> AsyncSession:
    """Database session dependency."""
    async with AsyncSessionLocal() as session:
        yield session


@router.post(
    "/register",
    response_model=RegisterResponse,
    status_code=status.HTTP_201_CREATED,
    responses={
        400: {"model": ErrorResponse, "description": "Email hoặc username đã tồn tại"},
    },
)
async def register(
    request: RegisterRequest,
    db: AsyncSession = Depends(get_db),
) -> RegisterResponse:
    """Đăng ký tài khoản mới.
    
    Args:
        request: Thông tin đăng ký (email, username, password)
        db: Database session
        
    Returns:
        RegisterResponse: Thông tin tài khoản đã tạo
        
    Raises:
        HTTPException 400: Nếu email hoặc username đã tồn tại
    """
    # Check if email already exists
    result = await db.execute(
        select(AdminAccount).where(AdminAccount.email == request.email)
    )
    existing_email = result.scalar_one_or_none()
    if existing_email:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Email đã được sử dụng",
        )
    
    # Check if username already exists
    result = await db.execute(
        select(AdminAccount).where(AdminAccount.username == request.username)
    )
    existing_username = result.scalar_one_or_none()
    if existing_username:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Username đã được sử dụng",
        )
    
    # Hash password
    password_hash = hash_password(request.password)
    
    # Create new account
    new_account = AdminAccount(
        email=request.email,
        username=request.username,
        password_hash=password_hash,
    )
    
    db.add(new_account)
    await db.commit()
    await db.refresh(new_account)
    
    log.info(f"New account registered: {new_account.email} (username={new_account.username}, id={new_account.id})")
    
    return RegisterResponse(
        account_id=str(new_account.id),
        email=new_account.email,
        username=new_account.username,
        message="Đăng ký thành công",
    )


@router.post(
    "/login",
    response_model=LoginResponse,
    responses={
        401: {"model": ErrorResponse, "description": "Thông tin đăng nhập không đúng"},
    },
)
async def login(
    request: LoginRequest,
    db: AsyncSession = Depends(get_db),
) -> LoginResponse:
    """Đăng nhập vào hệ thống.
    
    Supports login with username OR email (stored in username field).
    
    Args:
        request: Thông tin đăng nhập (username_or_email, password)
        db: Database session
        
    Returns:
        LoginResponse: Access token và thông tin người dùng
        
    Raises:
        HTTPException 401: Nếu thông tin đăng nhập không đúng
    """
    # Find user by username/email (currently stored in username field)
    result = await db.execute(
        select(AdminAccount).where(
            AdminAccount.username == request.username_or_email
        )
    )
    account = result.scalar_one_or_none()
    
    # Verify password
    if not account or not verify_password(request.password, account.password_hash):
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Tên đăng nhập hoặc mật khẩu không đúng",
        )
    
    # Check if account is active
    if not account.is_active:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Tài khoản đã bị vô hiệu hóa",
        )
    
    # Create access token
    access_token = create_access_token(
        data={
            "sub": str(account.id),
            "username": account.username,
            "role": "admin",  # Default role for now
        }
    )
    
    log.info(f"User logged in: {account.username} (id={account.id})")
    
    return LoginResponse(
        access_token=access_token,
        token_type="bearer",
        user=UserResponse(
            account_id=str(account.id),
            email=account.username,  # Using username as email for now
            username=account.username,
            role="admin",
        ),
    )


@router.get(
    "/me",
    response_model=UserResponse,
    responses={
        401: {"model": ErrorResponse, "description": "Chưa đăng nhập hoặc token không hợp lệ"},
    },
)
async def get_me(
    current_user: dict = Depends(get_current_user),
) -> UserResponse:
    """Lấy thông tin người dùng hiện tại.
    
    Args:
        current_user: User information from JWT token
        
    Returns:
        UserResponse: Thông tin người dùng
    """
    return UserResponse(
        account_id=current_user["sub"],
        email=current_user.get("username", ""),
        username=current_user.get("username", ""),
        role=current_user.get("role", "user"),
    )


@router.post(
    "/google",
    response_model=LoginResponse,
    responses={
        401: {"model": ErrorResponse, "description": "Google ID token không hợp lệ"},
    },
)
async def google_auth(
    request: GoogleAuthRequest,
    db: AsyncSession = Depends(get_db),
) -> LoginResponse:
    """Đăng nhập hoặc đăng ký bằng Google OAuth 2.0.
    
    Args:
        request: Google ID token từ OAuth flow
        db: Database session
        
    Returns:
        LoginResponse: Access token và thông tin người dùng
        
    Raises:
        HTTPException 401: Nếu Google ID token không hợp lệ
    """
    # Verify Google ID token
    try:
        async with httpx.AsyncClient() as client:
            response = await client.get(
                f"https://oauth2.googleapis.com/tokeninfo?id_token={request.id_token}",
                timeout=10.0,
            )
            
            if response.status_code != 200:
                raise HTTPException(
                    status_code=status.HTTP_401_UNAUTHORIZED,
                    detail="Google ID token không hợp lệ",
                )
            
            token_info = response.json()
            
            # Validate required fields
            email = token_info.get("email")
            if not email:
                raise HTTPException(
                    status_code=status.HTTP_401_UNAUTHORIZED,
                    detail="Không thể lấy email từ Google",
                )
            
            # Check if email is verified
            if not token_info.get("email_verified"):
                raise HTTPException(
                    status_code=status.HTTP_401_UNAUTHORIZED,
                    detail="Email chưa được xác thực bởi Google",
                )
            
    except httpx.RequestError as e:
        log.error(f"Failed to verify Google token: {e}")
        raise HTTPException(
            status_code=status.HTTP_503_SERVICE_UNAVAILABLE,
            detail="Không thể kết nối đến Google để xác thực",
        )
    
    # Find or create account
    result = await db.execute(
        select(AdminAccount).where(AdminAccount.username == email)
    )
    account = result.scalar_one_or_none()
    
    if not account:
        # Create new account for Google user
        # Generate a random password hash (user won't use it for Google login)
        random_password = secrets.token_urlsafe(32)
        password_hash = hash_password(random_password)
        
        account = AdminAccount(
            username=email,
            password_hash=password_hash,
            is_active=True,
        )
        
        db.add(account)
        await db.commit()
        await db.refresh(account)
        
        log.info(f"New Google account created: {email} (id={account.id})")
    else:
        # Check if existing account is active
        if not account.is_active:
            raise HTTPException(
                status_code=status.HTTP_401_UNAUTHORIZED,
                detail="Tài khoản đã bị vô hiệu hóa",
            )
        
        log.info(f"Existing Google account logged in: {email} (id={account.id})")
    
    # Create access token
    access_token = create_access_token(
        data={
            "sub": str(account.id),
            "username": account.username,
            "role": "admin",
            "auth_method": "google",
        }
    )
    
    return LoginResponse(
        access_token=access_token,
        token_type="bearer",
        user=UserResponse(
            account_id=str(account.id),
            email=account.username,
            username=account.username,
            role="admin",
        ),
    )


@router.post(
    "/forgot-password",
    status_code=status.HTTP_200_OK,
    responses={
        200: {"description": "Email hướng dẫn khôi phục đã được gửi (hoặc email không tồn tại)"},
    },
)
async def forgot_password(
    request: ForgotPasswordRequest,
    db: AsyncSession = Depends(get_db),
) -> dict[str, str]:
    """Yêu cầu khôi phục mật khẩu qua email.
    
    Args:
        request: Email để nhận link khôi phục
        db: Database session
        
    Returns:
        Message thông báo đã gửi email
        
    Note:
        Luôn trả về 200 OK để tránh leak thông tin email tồn tại hay không.
        Gửi email thực tế nếu SMTP được config, nếu không sẽ print link ra console.
    """
    # Find account by email
    result = await db.execute(
        select(AdminAccount).where(AdminAccount.username == request.email)
    )
    account = result.scalar_one_or_none()
    
    if account:
        # Generate reset token
        reset_token = create_password_reset_token(request.email)
        
        # Get frontend base URL from settings
        from fastapi import Request as FastAPIRequest
        frontend_url = "http://localhost:3000"  # Default fallback
        
        reset_link = f"{frontend_url}/reset-password?token={reset_token}"
        
        # Try to send email via SMTP
        email_service = get_email_service()
        if email_service.enabled:
            email_sent = email_service.send_password_reset_email(
                to_email=request.email,
                reset_link=reset_link,
                username=account.username,
            )
            if email_sent:
                log.info(f"Password reset email sent to: {request.email}")
                return {
                    "message": "Nếu email tồn tại trong hệ thống, hướng dẫn khôi phục đã được gửi đến hòm thư của bạn."
                }
        
        # Fallback: Print link to console
        log.info(f"Password reset requested for: {request.email}")
        log.info(f"Reset link (copy to browser): {reset_link}")
        print(f"\n{'='*80}")
        print(f"PASSWORD RESET LINK FOR: {request.email}")
        print(f"{reset_link}")
        print(f"{'='*80}\n")
    
    # Always return success message (security best practice)
    return {
        "message": "Nếu email tồn tại trong hệ thống, hướng dẫn khôi phục đã được gửi (kiểm tra Terminal backend nếu SMTP chưa config)."
    }


@router.post(
    "/reset-password",
    status_code=status.HTTP_200_OK,
    responses={
        400: {"model": ErrorResponse, "description": "Token không hợp lệ hoặc đã hết hạn"},
    },
)
async def reset_password(
    request: ResetPasswordRequest,
    db: AsyncSession = Depends(get_db),
) -> dict[str, str]:
    """Đặt lại mật khẩu với token hợp lệ.
    
    Args:
        request: Token và mật khẩu mới
        db: Database session
        
    Returns:
        Message thông báo đặt lại mật khẩu thành công
        
    Raises:
        HTTPException 400: Nếu token không hợp lệ hoặc đã hết hạn
    """
    # Verify token and get email
    email = verify_password_reset_token(request.token)
    
    if not email:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Token không hợp lệ hoặc đã hết hạn",
        )
    
    # Find account by email
    result = await db.execute(
        select(AdminAccount).where(AdminAccount.username == email)
    )
    account = result.scalar_one_or_none()
    
    if not account:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Tài khoản không tồn tại",
        )
    
    # Hash new password
    new_password_hash = hash_password(request.new_password)
    
    # Update password
    account.password_hash = new_password_hash
    await db.commit()
    
    log.info(f"Password reset successfully for: {email}")
    
    return {
        "message": "Đặt lại mật khẩu thành công"
    }


