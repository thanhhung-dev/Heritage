# Copy these settings into the repository root .env or process environment.
# This example is not loaded automatically. Never commit actual secret values.

# Required for JWT issuance and verification. Generate a random secret (32+ bytes).
JWT_SECRET_KEY=

# Optional. When set, new tokens carry these values and verification enforces them.
# Set consistently on every worker. Enabling them rejects older tokens without them.
JWT_ISSUER=
JWT_AUDIENCE=

# DATABASE_URL uses the existing backend PostgreSQL configuration.
# Apply ../migrations/2026-11-17_revoked_access_token.sql before enabling this code.
