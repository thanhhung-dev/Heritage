# Cổng mở trên máy chạy Docker
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Browser chạy trên chính máy Docker. Nếu truy cập từ máy khác trong LAN,
# thay localhost bằng IP của máy Docker rồi chạy lại docker compose build frontend.
NEXT_PUBLIC_API_URL=http://localhost:8000

LLAMA_GPU_LAYERS=0
LLAMA_PORT=8080
LLAMA_SERVER_TIMEOUT=300


# Database
POSTGRES_DB=heritagegraph
POSTGRES_USER=heritagegraph
POSTGRES_PASSWORD=change-this-in-local-env
