APP_ENVIRONMENT=local
OTEL_SERVICE_NAME=heritage-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_TRACING_ENABLED=false

OBSERVABILITY_CONTENT_CAPTURE=metadata

# Langfuse local (profile observability). Generate unique values in your ignored .env.
LANGFUSE_ENABLED=false
LANGFUSE_PORT=3003
LANGFUSE_POSTGRES_PASSWORD=replace-with-a-random-local-password
LANGFUSE_CLICKHOUSE_PASSWORD=replace-with-a-random-local-password
LANGFUSE_REDIS_PASSWORD=replace-with-a-random-local-password
LANGFUSE_MINIO_PASSWORD=replace-with-a-random-local-password
LANGFUSE_SALT=replace-with-openssl-rand-hex-32
LANGFUSE_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
LANGFUSE_NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-replace-with-local-key
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-replace-with-local-key
LANGFUSE_INIT_USER_EMAIL=operator@example.local
LANGFUSE_INIT_USER_NAME=HeritageGraph Operator
LANGFUSE_INIT_USER_PASSWORD=replace-with-a-random-local-password
CORPUS_VERSION=1

POSTGRES_DB=heritagegraph
POSTGRES_USER=heritagegraph
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_DB}


CORS_ORIGINS=
R2_PUBLIC_BASE_URL=
R2_ALLOWED_ASSET_HOSTS=

# Local llama.cpp server configuration.
INFERENCE_BACKEND=llama_server
LLAMA_SERVER_URL=http://localhost:8080
LLAMA_SERVER_TIMEOUT=300
