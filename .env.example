APP_ENVIRONMENT=local
CORS_ORIGINS=

# Docker Compose chạy PostgreSQL và OpenSearch; backend chạy local.
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=heritage-passages-v1
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
PASSAGE_MIN_SIMILARITY=0.55

# PostgreSQL chạy qua compose.yaml (host port 5433)
POSTGRES_DB=heritage
POSTGRES_USER=heritage
POSTGRES_PASSWORD=heritage-dev-password
DATABASE_URL=postgresql+psycopg://heritage:heritage-dev-password@127.0.0.1:5433/heritage

# Source documents/media remain on R2. Q&A reads text from OpenSearch.
R2_BUCKET=knowledge
R2_PUBLIC_BASE_URL=
R2_ALLOWED_ASSET_HOSTS=

# SMTP Email Configuration (Optional - for password reset emails)
# Leave empty to print reset links to console instead
# Gmail example: smtp.gmail.com:587 with App Password
# Mailgun/SendGrid: Use their SMTP credentials
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=Heritage Support
SMTP_USE_TLS=true

# Frontend base URL (for email links)
FRONTEND_BASE_URL=http://localhost:3000

# Local llama.cpp server configuration.
INFERENCE_BACKEND=llama_server
LLAMA_SERVER_URL=http://127.0.0.1:8080
LLAMA_SERVER_TIMEOUT=300
# Optional override; SentenceTransformer selects the available device by default.
EMBEDDING_DEVICE=

# Observability is deferred. No Langfuse/ClickHouse/Grafana containers.
LANGFUSE_ENABLED=false
OTEL_TRACING_ENABLED=false
OTEL_SERVICE_NAME=heritage-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OBSERVABILITY_CONTENT_CAPTURE=metadata

# Optional Microsoft GraphRAG; export chunks from OpenSearch before indexing.
GRAPHRAG_ENABLED=false
GRAPHRAG_ROOT=
GRAPHRAG_PYTHON=.venv-graphrag/bin/python
GRAPHRAG_QUERY_TIMEOUT=180
GRAPHRAG_MODEL=local-model
GRAPHRAG_API_BASE=http://127.0.0.1:8080/v1
GRAPHRAG_LLM_API_KEY=local-not-a-secret


R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<R2_ACCESS_KEY>
R2_SECRET_ACCESS_KEY=<R2_SECRET_KEY>
R2_BUCKET=knowledge
R2_KNOWLEDGE_PREFIX=curated/
R2_UPLOAD_MAX_BYTES=26214400