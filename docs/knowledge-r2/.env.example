# Bổ sung các giá trị phía server vào môi trường triển khai hiện có.
# Không đưa thông tin xác thực vào NEXT_PUBLIC_* hoặc mã chạy trên trình duyệt.
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-bucket-scoped-key
R2_SECRET_ACCESS_KEY=replace-with-private-secret
R2_KNOWLEDGE_BUCKET=knowledge-heritage
R2_KNOWLEDGE_LIBRARY_PREFIX=
KNOWLEDGE_MAX_UPLOAD_BYTES=10485760
KNOWLEDGE_PREVIEW_MAX_BYTES=131072
# Tái sử dụng URL PostgreSQL hiện có và đặt JWT_SECRET_KEY riêng tư.
# Không thay đổi R2_BUCKET, R2_KNOWLEDGE_PREFIX hoặc cấu hình bucket media.
