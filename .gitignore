# ===== Model weights (base 14GB, fused ~15GB, LoRA adapter) =====
# backend/models/*.py là SQLAlchemy models; chỉ bỏ qua thư mục/trọng số model AI.
backend/models/*/
backend/models/*.safetensors
backend/models/*.gguf
backend/models/*.pt
backend/models/*.pth
backend/models/*.npz
backend/models/*.mlx
*.safetensors
*.gguf
*.pt
*.pth
*.npz
*.mlx

# models/ giữ cấu trúc thư mục qua .gitkeep, bỏ qua nội dung
models/**
!models/**/
!models/**/.gitkeep

# ===== Corpus & training data (sinh ra từ ingestion/ + teacher model) =====
# corpus/wiki: output của crawl_wiki_mientrung.py
# corpus/* KHÔNG phải corpus/: git không đi vào thư mục đã bị ignore, nên mẫu
# "corpus/" làm dòng !corpus/aliases.json dưới đây vô hiệu.
corpus/*
# TRỪ aliases.json: sinh lại cần MẠNG (redirect Wikipedia) nhưng runtime phải
# offline được. File nhỏ, đọc được bằng mắt, sửa tay được -> giữ trong git.
!corpus/aliases.json
# Dữ liệu location đã được duyệt thủ công cùng URL/câu nguồn chính thức.
!corpus/verified_locations.json

# data/: train.jsonl, valid.jsonl do make_smoke_data.py / bootstrap sinh ra
data/**
!data/**/
!data/**/.gitkeep

# ===== GraphRAG =====
# input/: chunks từ chunk_corpus_mt.py; output/cache/logs: artifact khi index
graphrag/input/**
!graphrag/input/**/
!graphrag/input/**/.gitkeep
graphrag/output/
graphrag/cache/
graphrag/logs/
graphrag/*.log
# Giữ lại: graphrag/settings.yaml, graphrag/prompts/ (config đã tune tay)

# ===== Eval =====
# gold.jsonl gán nhãn tay -> vẫn commit; report.json do score_gold.py sinh ra
eval/report.json
eval/report*.json

